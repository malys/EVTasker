<?xml version="1.0" encoding="utf-8"?>
<!-- EVTasker is an independent system app: it reads and writes the vehicle directly
     through the shared EVHardware layer, and works with no EVProfile installed.
     sharedUserId + the platform signature are what grant vehicle access (the car
     permissions are signature|privileged), exactly as EVProfile does.

     EVProfile is optional: when it is installed, the "Apply EVProfile profile" action
     becomes available (via its signature-protected bridge). That is the only capability
     that needs EVProfile. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <!-- Vehicle access (Android Automotive / SAIC) — same set EVProfile uses. -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Own vehicle service: foreground + wake + start at boot to catch the ignition. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The SAIC hard-key report is otherwise forgeable by any app. Requiring this from
         the sender admits the platform-signed OEM hard-key service only. -->
    <permission
        android:name="com.evsuite.tasker.permission.RECEIVE_HARDKEY"
        android:protectionLevel="signature" />

    <!-- Bluetooth: paired list for the editor, and live connection tracking for rules. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Reads which phone the head unit made hands-free, for the "hands-free phone"
         condition. Granted by the platform signature; without it that one condition
         reports as unreadable and nothing else changes. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />
    <!-- Requested only when the user chooses "Call a contact". The OEM PBAP client
         publishes the paired phone's downloaded phone book through ContactsContract. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Position, for the "near a place" condition only. Last known fix, never a live
         request, never sent anywhere: it is compared to a point stored in the rule and the
         result is a yes/no. Denying it disables that one condition and nothing else.
         COARSE is declared alongside FINE because the platform requires the pair; a radius
         in metres is what FINE is for, and COARSE alone still answers a wide-enough one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Optional EVProfile bridge (the "apply profile" action only). Signature-level,
         obtained solely because both APKs are signed with the same platform key. -->
    <uses-permission android:name="com.evsuite.profile.permission.CONTROL_PROFILES" />

    <!-- API 30+: list installed apps for the "launch an app" action; detect EVProfile. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Every EVProfile channel: the offline and unstable builds carry a suffixed
             application id and are the same app. Declaring only the stable id made
             EVProfile invisible on a car that had it, and the profile actions vanished
             from the rule editor with it. -->
        <package android:name="com.evsuite.profile" />
        <package android:name="com.evsuite.profile.offline" />
        <package android:name="com.evsuite.profile.unstable" />
        <package android:name="com.evsuite.profile.offline.unstable" />
        <!-- API 30+: without this the TTS engine is invisible and the "speak" action
             would report "no speech engine" on a car that has one installed. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <!-- Runtime-compatible map components that publish no geo: filter; explicit
             package visibility lets the app offer navigation when either is installed. -->
        <package android:name="com.saicmotor.navigation" />
        <package android:name="com.telenav.app.arp" />
        <package android:name="com.nng.igo.primong" />
        <package android:name="com.mmi.navimaps_auto" />
    </queries>

    <application
        android:name=".EVTaskerApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.EVTasker"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true">

        <!-- Car API (CarPropertyManager / CarHvacManager reflection targets). -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RuleEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- One case of a rule ("if", "else if", "else"), edited on its own screen. -->
        <activity
            android:name=".ui.BranchEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- Long profile-safety guidance needs the whole vehicle display, never a popup. -->
        <activity
            android:name=".ui.ProfileAutomationWarningActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- A rule's own yes/no question. Launched from the vehicle service while a rule is
             running, so it comes up over whatever the head unit is showing; excluded from
             recents because it belongs to that one rule and means nothing after it. -->
        <activity
            android:name=".ui.ConfirmActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />

        <!-- Persistent vehicle service: inits EVHardware, listens for ignition, evaluates
             rules and applies actions directly. connectedDevice matches what it does. -->
        <service
            android:name=".service.TaskerVehicleService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="connectedDevice" />

        <!-- Runs one evaluation cycle for a manual test (from the Rules screen). -->
        <service
            android:name=".service.TaskerRunService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
