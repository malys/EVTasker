<?xml version="1.0" encoding="utf-8"?>
<!-- MG4Tasker is an independent system app: it reads and writes the vehicle directly
     through the shared MG4Hardware layer, and works with no MG4Control installed.
     sharedUserId + the platform signature are what grant vehicle access (the car
     permissions are signature|privileged), exactly as MG4Control does.

     MG4Control is optional: when it is installed, the "Apply MG4Control profile" action
     becomes available (via its signature-protected bridge). That is the only capability
     that needs MG4Control. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system">

    <!-- Vehicle access (Android Automotive / SAIC) — same set MG4Control uses. -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Own vehicle service: foreground + wake + start at boot to catch the ignition. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bluetooth: paired list for the editor, and live connection tracking for rules. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Optional MG4Control bridge (the "apply profile" action only). Signature-level,
         obtained solely because both APKs are signed with the same platform key. -->
    <uses-permission android:name="com.mg4.control.permission.CONTROL_PROFILES" />

    <!-- API 30+: list installed apps for the "launch an app" action; detect MG4Control. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.mg4.control" />
        <!-- API 30+: without this the TTS engine is invisible and the "speak" action
             would report "no speech engine" on a car that has one installed. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".MG4TaskerApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MG4Tasker"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true">

        <!-- Car API (CarPropertyManager / CarHvacManager reflection targets). -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RuleEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- Persistent vehicle service: inits MG4Hardware, listens for ignition, evaluates
             rules and applies actions directly. connectedDevice matches what it does. -->
        <service
            android:name=".service.TaskerVehicleService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="connectedDevice" />

        <!-- Runs one evaluation cycle for a manual test (from the Rules screen). -->
        <service
            android:name=".service.TaskerRunService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
