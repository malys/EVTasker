<?xml version="1.0" encoding="utf-8"?>
<!-- MG4Suite tokens - DARK theme. See DESIGN.md section Colors.
     Generated by tools/sync-tokens.mjs and identical in all five apps.

     Dark remains the mode that matters in a vehicle: a light background filling the
     windscreen at night is glare. The suite moved to DayNight by explicit decision,
     which does not cancel that constraint - it is the light palette that had to rise
     to the same 7:1 floor, not the other way round.

     Values not redefined here fall back to values/, which is why mg4_icon_tile is
     declared once, in the light file. -->
<resources>
    <color name="mg4_background">#FF0B0D0F</color>
    <color name="mg4_surface">#FF15181C</color>
    <color name="mg4_surface_raised">#FF272C33</color>
    <!-- 4.70:1 on mg4_surface. The previous #4A525B sat at 2.25:1: a border below
         the 3:1 non-text floor is a border that is not there. -->
    <color name="mg4_outline">#FF7A8492</color>
    <color name="mg4_text_primary">#FFF4F7FA</color>
    <!-- 8.91:1 worst case (on mg4_surface_raised) - the previous #9EA6AE fell to
         6:1, unreadable in sunlight. -->
    <color name="mg4_text_secondary">#FFC6CFD8</color>
    <color name="mg4_accent">#FF7FD4FA</color>
    <color name="mg4_on_accent">#FF04121A</color>

    <!-- Status. Never the sole carrier of meaning: a text label always accompanies
         the colour. -->
    <color name="mg4_ok">#FF8FE6A6</color>
    <color name="mg4_warn">#FFFFC978</color>
    <color name="mg4_error">#FFFFACAC</color>

    <!-- Pressed: an alpha veil over the surface, not a different hue. -->
    <color name="mg4_pressed">#1FFFFFFF</color>
    <color name="mg4_pressed_strong">#33FFFFFF</color>
</resources>
