<?xml version="1.0" encoding="utf-8"?>
<!-- Nav tab background. The state comes from View.isSelected, set by
     MainActivity.markCurrentPage on the one tab whose page is on screen: the color is
     never applied by hand in code, which guarantees a tab cannot stay painted "active"
     if the list of screens changes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/ev_accent" />
    <item android:color="@color/ev_surface_raised" />
</selector>
