<?xml version="1.0" encoding="utf-8"?>
<!-- Button navigation rather than Material tabs: on a vehicle screen, always-visible
     64 dp targets beat a thin tab bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mg4_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_sm"
        android:background="@color/mg4_surface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/Text.MG4.Title"
            android:layout_marginEnd="@dimen/spacing_lg" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tabGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabRules"
                style="@style/Widget.MG4.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_rules" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabHistory"
                style="@style/Widget.MG4.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabDiagnostic"
                style="@style/Widget.MG4.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_diagnostic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabConsole"
                style="@style/Widget.MG4.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_console" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabConfig"
                style="@style/Widget.MG4.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_config" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
