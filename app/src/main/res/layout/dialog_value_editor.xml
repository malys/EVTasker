<?xml version="1.0" encoding="utf-8"?>
<!-- One dialog for every value type: only the block matching the ValueKind is made
     visible. One dialog per type would have multiplied files without changing anything
     for the user. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/value_editor_horizontal_inset"
        android:paddingVertical="@dimen/spacing_md">

        <TextView
            android:id="@+id/gatedExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:text="@string/editor_gated_explain"
            android:textAppearance="@style/Text.EV.Secondary"
            android:textColor="@color/ev_warn"
            android:visibility="gone" />

        <!-- Operator — comparable numeric conditions only -->
        <Spinner
            android:id="@+id/opSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:visibility="gone" />

        <!-- BOOL -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/boolSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <!-- NUMBER -->
        <LinearLayout
            android:id="@+id/numberBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/numberValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/Text.EV.Title" />

            <!-- Slider, not keyboard entry: adjusting a bounded value should be one
                 gesture, without opening a keyboard on the vehicle screen. -->
            <com.google.android.material.slider.Slider
                android:id="@+id/numberSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1" />
        </LinearLayout>

        <!-- ENUM / BT_DEVICE / PROFILE / APP -->
        <Spinner
            android:id="@+id/choiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contactBlock"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/value_contact_hint"
            android:visibility="gone">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/contactInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:minHeight="@dimen/touch_target"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/physicalButtonBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_sm" android:text="@string/physical_button_label" android:textAppearance="@style/Text.EV.SectionHeader" />
                <Spinner android:id="@+id/physicalButtonSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_sm" android:text="@string/physical_event_label" android:textAppearance="@style/Text.EV.SectionHeader" />
                <Spinner android:id="@+id/physicalPressSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/choiceEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.EV.Secondary"
            android:textColor="@color/ev_error"
            android:visibility="gone" />

        <!-- TIME_RANGE -->
        <LinearLayout
            android:id="@+id/timeBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/value_from"
                android:textAppearance="@style/Text.EV.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/timeFrom"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/value_to"
                android:textAppearance="@style/Text.EV.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/timeTo"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm" />
        </LinearLayout>

        <!-- DAYS -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/daysGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            android:visibility="gone" />

        <!-- DATE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dateButton"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:visibility="gone" />

        <!-- TEXT -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/value_notification_hint"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:textSize="@dimen/text_body"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/payloadBlock"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:hint="@string/value_webhook_body"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/payloadInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minHeight="@dimen/touch_target"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Saved places, shown only when there is at least one to pick. -->
        <Spinner
            android:id="@+id/placeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/locationActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locationCurrent"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/value_location_current" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locationMap"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/value_location_map" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locationSave"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/value_place_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
