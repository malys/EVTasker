<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/tab_console"
            android:textAppearance="@style/Text.EV.Title" />

        <!-- Export before Share: the head unit rarely has an app to share text to, so
             writing the file to storage is the path that actually works on the car. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportButton"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_export" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/console_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/console_clear" />
    </LinearLayout>

    <!-- Crash banner: a report from a previous run is the single most useful thing on
         this screen, so it is surfaced above the log rather than buried inside it. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/crashBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        app:cardBackgroundColor="@color/ev_surface_raised"
        app:cardCornerRadius="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/console_crash_title"
                android:textAppearance="@style/Text.EV.Body"
                android:textColor="@color/ev_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crashShowButton"
                style="@style/Widget.EV.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_crash_show" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crashDismissButton"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/console_crash_dismiss" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/consoleScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_md">

        <!-- Plain TextView, not a RecyclerView: the buffer is capped at 500 lines, so
             the whole thing fits without recycling, and selectable text makes it
             copy-pastable off the car. -->
        <TextView
            android:id="@+id/consoleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="@dimen/text_secondary"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
