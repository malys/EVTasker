<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ev_background">

    <!-- Action bar at the top, always visible: on a vehicle screen you do not scroll to
         find "Save". -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ev_surface"
        android:padding="@dimen/spacing_md">

        <TextView
            android:id="@+id/editorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.EV.Title"
            android:layout_marginEnd="@dimen/spacing_lg" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.EV.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/editor_save" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/editor_name_hint"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:textSize="@dimen/text_body"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- TRIGGER: which vehicle event addresses this rule at all -->
            <TextView
                android:id="@+id/triggerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/editor_trigger"
                android:textAppearance="@style/Text.EV.SectionHeader" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/triggerGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/triggerIgnitionOn"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_trigger_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/triggerGearPark"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_trigger_park" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/triggerIgnitionOff"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_trigger_off" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- THE CASES
                 One card per case, in the order they are tried. The conditions and the
                 actions are not here: they are written in the case's own window, where each
                 gets a full pane instead of two lists stacked in one column. What this
                 screen owns is the shape of the rule — which cases exist and in what
                 order — and that is what a card can show in one line. -->
            <LinearLayout
                android:id="@+id/branchContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_lg" />

            <TextView
                android:id="@+id/expertBranchesNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/editor_expert_branches_notice"
                android:textAppearance="@style/Text.EV.Secondary"
                android:textColor="@color/ev_warn"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/advancedBranchControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_lg">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addElseIfButton"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_add_else_if" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addElseButton"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/editor_add_else" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
