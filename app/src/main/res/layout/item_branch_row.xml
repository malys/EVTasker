<?xml version="1.0" encoding="utf-8"?>
<!-- One case of a rule — "if", an "else if", or the "else" — as it appears in the rule
     editor. The card is a door, not a form: what it shows is which case this is and how big
     it is, and tapping it opens the window where that case is actually written. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/mg4_surface_raised"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/mg4_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_sm">

        <LinearLayout
            android:id="@+id/branchClickArea"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="@dimen/touch_target"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/spacing_sm"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/branchKind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.MG4.SectionHeader" />

            <TextView
                android:id="@+id/branchSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/Text.MG4.Body" />

            <!-- Only the "else" carries it: it is the one case with no condition to read. -->
            <TextView
                android:id="@+id/branchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/editor_branch_else_hint"
                android:textAppearance="@style/Text.MG4.Secondary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Order decides which case wins, so the "else if" cards move. The "if" is always
             first and the "else" always last; both keep the buttons disabled rather than
             hidden, so no row's controls shift under a finger already reaching for them. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/branchUp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/touch_target"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:textSize="@dimen/text_body"
            android:text="@string/editor_move_up_glyph"
            android:contentDescription="@string/editor_move_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/branchDown"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/touch_target"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:textSize="@dimen/text_body"
            android:text="@string/editor_move_down_glyph"
            android:contentDescription="@string/editor_move_down" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/branchRemove"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:textSize="@dimen/text_body"
            android:text="@string/editor_remove" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
