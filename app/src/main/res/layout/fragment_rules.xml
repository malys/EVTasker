<?xml version="1.0" encoding="utf-8"?>
<!-- Two panes: the list stays visible while a rule is being viewed. On a wide screen,
     navigating list → detail → back would lose context on every round trip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="@dimen/pane_list_width"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/mg4_surface"
        android:padding="@dimen/spacing_md">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/automationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:textAppearance="@style/Text.MG4.Body"
            android:text="@string/rules_automation_switch" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newRuleButton"
            style="@style/Widget.MG4.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rules_new"
            android:layout_marginBottom="@dimen/spacing_md" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rulesList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="@dimen/spacing_lg">

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rules_empty_title"
                android:textAppearance="@style/Text.MG4.Title" />

            <TextView
                android:id="@+id/emptyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/rules_empty_body"
                android:textAppearance="@style/Text.MG4.Secondary" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/detailScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.MG4.Title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_md">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editButton"
                        style="@style/Widget.MG4.Button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/rules_edit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/runNowButton"
                        style="@style/Widget.MG4.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/rules_run_now" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteButton"
                        style="@style/Widget.MG4.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/rules_delete" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/rules_when"
                    android:textAppearance="@style/Text.MG4.SectionHeader" />

                <TextView
                    android:id="@+id/detailConditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.MG4.Body"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/rules_then"
                    android:textAppearance="@style/Text.MG4.SectionHeader" />

                <TextView
                    android:id="@+id/detailActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.MG4.Body"
                    android:lineSpacingMultiplier="1.3" />

                <!-- The "else if" cases and the "else", when the rule has any. Empty and
                     invisible for a plain if/then rule, which is most of them. -->
                <LinearLayout
                    android:id="@+id/detailCases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
