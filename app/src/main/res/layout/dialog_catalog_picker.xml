<?xml version="1.0" encoding="utf-8"?>
<!-- Plein écran, deux volets : le rail des groupes ne bouge jamais, la grille change.
     Un même groupe est donc toujours au même endroit d'une ouverture à l'autre, ce qui
     est la seule chose qui rende le choix rapide au volant.

     ConstraintLayout et pas des LinearLayout imbriqués : deux poids imbriqués font
     remesurer l'écran entier, et le sélecteur s'ouvre en pleine conduite.
     Pas de fond ici non plus : la fenêtre en peint déjà un (Theme.EV.Picker). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/pickerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ev_surface"
        android:padding="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/pickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/Text.EV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickerClose"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_cancel" />
    </LinearLayout>

    <View
        android:id="@+id/pickerBarDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/ev_outline"
        app:layout_constraintTop_toBottomOf="@id/pickerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/pickerRailScroll"
        android:layout_width="@dimen/pane_rail_width"
        android:layout_height="0dp"
        android:background="@color/ev_surface"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/pickerBarDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/pickerRail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="@dimen/spacing_sm" />
    </ScrollView>

    <View
        android:id="@+id/pickerRailDivider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/ev_outline"
        app:layout_constraintTop_toBottomOf="@id/pickerBarDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/pickerRailScroll" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pickerGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/spacing_sm"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/pickerBarDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/pickerRailDivider"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/pickerEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_lg"
        android:gravity="center"
        android:text="@string/picker_empty"
        android:textAppearance="@style/Text.EV.Secondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pickerBarDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/pickerRailDivider"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
