<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/diag_title"
            android:textAppearance="@style/Text.EV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshButton"
            style="@style/Widget.EV.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_refresh" />

        <!-- Export writes the diagnostic, the rules, the history, the log and any crash to
             storage: the car has no cable and no crash reporter, so this is the only way the
             whole picture leaves the vehicle. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportButton"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/diag_export" />
    </LinearLayout>

    <TextView
        android:id="@+id/summaryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:textAppearance="@style/Text.EV.Body" />

    <TextView
        android:id="@+id/bridgeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/diag_bridge_ko_hint"
        android:textAppearance="@style/Text.EV.Secondary"
        android:textColor="@color/ev_error"
        android:visibility="gone" />

    <!-- Feature support: which catalogue entries this firmware exposes. Computed
         automatically on first launch / after an update, re-runnable here on demand. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/supportStatus"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.EV.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkSupportButton"
            style="@style/Widget.EV.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_check_support" />
    </LinearLayout>

    <!-- Always shown: outside temperature is the only catalogue signal whose
         availability has not been verified on a vehicle. The user must be able to link
         "unreadable here" to "my weather rule never fires". -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/diag_temp_note"
        android:textAppearance="@style/Text.EV.Secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/diagList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_md"
        android:clipToPadding="false" />
</LinearLayout>
