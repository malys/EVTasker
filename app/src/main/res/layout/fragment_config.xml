<?xml version="1.0" encoding="utf-8"?>
<!-- Every setting of the app, in one place: the rules tab is the rule list, and a
     parameter set once a year has no claim on the space the list is read in. Single
     column with room to explain what a value does — nothing here is a quick gesture. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ev_background"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_section_language"
            android:textAppearance="@style/Text.EV.SectionHeader" />

        <!-- Full wording here, unlike the two-letter code the rules pane could afford. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/languageButton"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:layout_marginTop="@dimen/spacing_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/config_section_rule_editor"
            android:textAppearance="@style/Text.EV.SectionHeader" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/expertRulesSwitch"
            style="@style/Widget.EV.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target"
            android:text="@string/config_expert_rules" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/config_expert_rules_explain"
            android:textAppearance="@style/Text.EV.Secondary"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/config_section_rules_file"
            android:textAppearance="@style/Text.EV.SectionHeader" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/config_rules_file_explain"
            android:textAppearance="@style/Text.EV.Secondary"
            android:lineSpacingMultiplier="1.3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportButton"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/rules_export" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importButton"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:minHeight="@dimen/touch_target"
                android:text="@string/rules_import" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/config_section_about"
            android:textAppearance="@style/Text.EV.SectionHeader" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aboutButton"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_target"
            android:text="@string/about_action" />
    </LinearLayout>
</ScrollView>
