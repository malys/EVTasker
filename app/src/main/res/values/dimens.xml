<?xml version="1.0" encoding="utf-8"?>
<!-- MG4Suite tokens - metrics. See DESIGN.md sections Layout and Typography.
     Generated by tools/sync-tokens.mjs and identical in all five apps. App-specific
     dimensions are declared alongside, in dimens_app.xml, with the reason. -->
<resources>
    <!-- Vehicle screen: 12.8", ~70 cm from the driver, used while driving, sometimes
         in full sun, by fingers that aim badly. Everything is larger than on a
         hand-held phone. DPI is user-adjustable per app on this platform, so nothing
         assumes a pixel size. -->
    <dimen name="touch_target">72dp</dimen>
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>

    <!-- One radius across the whole suite: it is what makes five apps written by
         different hands read as one. -->
    <dimen name="mg4_corner">12dp</dimen>

    <!-- Text sizes. The floor is text_label: below 16sp, contrast no longer
         compensates for reflection and reading distance. -->
    <dimen name="text_display">32sp</dimen>
    <dimen name="text_title">26sp</dimen>
    <dimen name="text_body">20sp</dimen>
    <dimen name="text_secondary">17sp</dimen>
    <dimen name="text_label">16sp</dimen>
</resources>
