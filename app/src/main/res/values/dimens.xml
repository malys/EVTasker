<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Écran de véhicule : environ 10 pouces, à ~70 cm du conducteur, utilisé en
         conduite, parfois en plein soleil et par des doigts qui visent mal. Tout est
         plus grand que sur un téléphone tenu en main. -->
    <dimen name="touch_target">72dp</dimen>
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>

    <!-- Tailles de texte : le plancher est text_secondary, qui doit rester lisible en
         plein jour. En dessous de 16sp le contraste ne suffit plus à compenser le reflet. -->
    <dimen name="text_title">26sp</dimen>
    <dimen name="text_body">20sp</dimen>
    <dimen name="text_secondary">17sp</dimen>
    <dimen name="text_label">16sp</dimen>

    <!-- Largeur du volet gauche en paysage. Assez pour lire un nom de règle complet,
         assez étroit pour que le détail reste la zone principale. -->
    <dimen name="pane_list_width">380dp</dimen>

    <!-- Rail des groupes du sélecteur. Plus étroit que pane_list_width : il ne porte que
         des libellés de groupe, et chaque dp pris ici est un dp de moins pour la grille. -->
    <dimen name="pane_rail_width">300dp</dimen>

    <!-- Tuile du sélecteur : deux fois la cible tactile minimale, pour qu'un libellé sur
         trois lignes plus la mention « à l'arrêt uniquement » tiennent sans repousser
         la ligne suivante. -->
    <dimen name="catalog_tile_height">128dp</dimen>
    <dimen name="catalog_tile_radius">12dp</dimen>

    <!-- Largeur minimale d'une tuile, utilisée pour calculer le nombre de colonnes. En
         dessous, un libellé comme « Régulateur de vitesse adaptatif » se coupe. -->
    <dimen name="catalog_tile_min_width">240dp</dimen>
</resources>
