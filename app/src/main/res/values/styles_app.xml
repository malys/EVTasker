<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app styles (not synced by tools/sync-tokens.mjs — see styles_ev.xml for the
     shared set). -->
<resources>

    <!-- Icon-over-label nav tab, identical to EVProfile's. The tabs share the bar's
         width equally, so the label has to shrink rather than push its neighbours
         around: hence autoSize and a single line. Selected state is View.isSelected,
         set by MainActivity.markCurrentPage, read by the res/color/nav_tab_*.xml
         selectors — no color is ever set from code. -->
    <style name="Widget.EV.NavTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_xs</item>
        <item name="android:paddingEnd">@dimen/spacing_xs</item>
        <item name="android:paddingTop">@dimen/spacing_xs</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
        <item name="android:maxLines">1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nav_tab_foreground</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">@dimen/text_label</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">@dimen/spacing_xs</item>
        <item name="iconTint">@color/nav_tab_foreground</item>
        <item name="backgroundTint">@color/nav_tab_background</item>
        <item name="strokeColor">@color/nav_tab_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/ev_corner</item>
        <item name="elevation">0dp</item>
    </style>

</resources>
