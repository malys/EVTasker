<?xml version="1.0" encoding="utf-8"?>
<!-- MG4Suite - component styles. See DESIGN.md section Components.
     Generated by tools/sync-tokens.mjs: identical in all five apps, edit only
     tools/tokens/styles.xml. The application theme itself stays in values/themes.xml,
     because its name changes from one app to the next.

     These styles carry the same names everywhere, so a screen can move between
     repositories without being renamed. -->
<resources>

    <!-- Dialogs inherit the same contrast as everything else: without this they fall
         back to Material's default palette, an indoor grey-mauve that is the first
         thing to wash out in sunlight. -->
    <style name="ThemeOverlay.MG4.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/mg4_surface_raised</item>
        <item name="colorOnSurface">@color/mg4_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/mg4_text_secondary</item>
        <item name="android:textColorPrimary">@color/mg4_text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MG4.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MG4.DialogButton</item>
    </style>

    <!-- 72dp touch target: the finger aims badly on the road and the screen is far
         away. This is the minimum used everywhere in the suite, including where
         Material offers something much smaller. -->
    <style name="Widget.MG4.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
    </style>

    <style name="Widget.MG4.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
    </style>

    <!-- Dialog buttons are the smallest thing in any app and the easiest to miss:
         pulled up to the same target as the rest. -->
    <style name="Widget.MG4.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">140dp</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- A switch that needs a precise tap is a switch that gets missed at 90 km/h. -->
    <style name="Widget.MG4.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/mg4_text_primary</item>
    </style>

    <!-- The only tracked type in the suite. The tracking is what lets it work at the
         16sp floor without shouting. -->
    <style name="Text.MG4.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/mg4_accent</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- One Display element per screen: two 32sp numbers competing for attention are
         two glances, and the glance is the budget. -->
    <style name="Text.MG4.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/mg4_text_primary</item>
    </style>

    <style name="Text.MG4.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/mg4_text_primary</item>
    </style>

    <style name="Text.MG4.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/mg4_text_primary</item>
    </style>

    <style name="Text.MG4.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/mg4_text_secondary</item>
    </style>
</resources>
