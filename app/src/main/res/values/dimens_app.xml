<?xml version="1.0" encoding="utf-8"?>
<!-- Dimensions specific to EVTasker. Shared tokens are in dimens.xml (generated by
     tools/sync-tokens.mjs - do not add a local value there). -->
<resources>
    <!-- Width of the left pane in landscape. Wide enough to read a full rule name,
         narrow enough that the detail stays the primary area. -->
    <dimen name="pane_list_width">380dp</dimen>

    <!-- Group rail in the picker. Narrower than pane_list_width: it carries only group
         labels, and every dp taken here is a dp less for the grid. -->
    <dimen name="pane_rail_width">300dp</dimen>

    <!-- Picker tile: twice the minimum touch target, so a three-line label plus the
         "at standstill only" qualifier fits without pushing the next row. -->
    <dimen name="catalog_tile_height">128dp</dimen>
    <dimen name="catalog_tile_radius">@dimen/ev_corner</dimen>

    <!-- Minimum tile width, used to compute the column count. Below this, a label like
         "Adaptive cruise control" is cut. -->
    <dimen name="catalog_tile_min_width">240dp</dimen>

    <!-- Keeps editor controls in the driver's central reading cone instead of stretching
         from bezel to bezel on the 12.8-inch landscape display. -->
    <dimen name="value_editor_horizontal_inset">64dp</dimen>
</resources>
