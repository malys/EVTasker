<?xml version="1.0" encoding="utf-8"?>
<!-- MG4Suite tokens - LIGHT theme. See DESIGN.md section Colors.
     Generated by tools/sync-tokens.mjs and identical in all five apps: edit
     tools/tokens/colors.light.xml, not this copy, and re-check the ratios.

     Contrast: this screen is read in daylight, usually through a reflection. Every
     text colour clears 7:1 (AAA) on every surface it can land on, not the 4.5:1 AA
     minimum, which collapses as soon as outside brightness rises. The AAA floor
     applies to the light theme too - a badly contrasted light theme is no more
     readable than a badly contrasted dark one. -->
<resources>
    <color name="mg4_background">#FFF2F4F7</color>
    <color name="mg4_surface">#FFFFFFFF</color>
    <color name="mg4_surface_raised">#FFE4E8ED</color>
    <!-- Card border. Without it, surface and surface_raised merge in sunlight.
         4.07:1 on mg4_surface - above the 3:1 floor for non-text UI (WCAG 1.4.11),
         which the previous #4A525B (2.25:1) did not clear. -->
    <color name="mg4_outline">#FF737F8F</color>
    <color name="mg4_text_primary">#FF101418</color>
    <!-- 7.22:1 worst case (on mg4_surface_raised). -->
    <color name="mg4_text_secondary">#FF414B55</color>
    <!-- A deep cyan, not the dark theme's pale one: a pale cyan on white falls to
         1.5:1 and disappears outright in daylight. 7.69:1 worst case. -->
    <color name="mg4_accent">#FF044C63</color>
    <color name="mg4_on_accent">#FFFFFFFF</color>

    <!-- Status. Never the sole carrier of meaning: a text label always accompanies
         the colour. -->
    <color name="mg4_ok">#FF09501F</color>
    <color name="mg4_warn">#FF6B3A00</color>
    <color name="mg4_error">#FF8F0F18</color>

    <!-- Pressed: an alpha veil over the surface, not a different hue, so a pressed
         card still reads as the same card. -->
    <color name="mg4_pressed">#14000000</color>
    <color name="mg4_pressed_strong">#29000000</color>

    <!-- Launcher icon tile. The same in light and dark: it is the suite's mark, not
         a surface. See DESIGN.md section Iconography. -->
    <color name="mg4_icon_tile">#FF2A2A2A</color>
</resources>
